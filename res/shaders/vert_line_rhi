#version 330 core
// D1 宽线（RHI 展开路径）顶点着色器：线段不做 GL_LINES 光栅化，
// 而是 CPU 端每段展开成 2 个三角形，GPU 在屏幕（像素）空间做法向扩展。
// 顶点属性：
//   aPosA/aPosB = 线段两端点（同一世界空间坐标随顶点冗余携带）
//   aLine       = (端别 0=A 端/1=B 端, 侧别 ±1, 宽度像素, 保留)
//   aScreen     = (2/viewportW, 2/viewportH) 像素→NDC 换算（CPU 每帧刷新烘焙）
// 展开算法：两端点投影到 NDC → 换算像素空间求方向 → 法向偏移 ±宽/2 像素
// → 乘回 ndcPerPx 折回 NDC → 乘 clip.w 消除透视分母。
layout (location = 0) in vec3 aPosA;
layout (location = 1) in vec3 aPosB;
layout (location = 2) in vec4 aLine;
layout (location = 3) in vec2 aScreen;

uniform mat4 uMatrixMVP;

void main()
{
    vec4 clipA = uMatrixMVP * vec4(aPosA, 1.0);
    vec4 clipB = uMatrixMVP * vec4(aPosB, 1.0);
    // 任一端点在相机后方（w<=0）：透视除法翻转导致展开方向失真，整段退化丢弃
    if (clipA.w <= 0.0 || clipB.w <= 0.0) {
        gl_Position = vec4(2.0, 2.0, 2.0, 1.0);   // 裁剪体外，不可见
        return;
    }
    vec2 ndcA = clipA.xy / clipA.w;
    vec2 ndcB = clipB.xy / clipB.w;
    vec2 dPx = (ndcB - ndcA) / aScreen;          // 像素空间方向向量
    float len = length(dPx);
    dPx = len > 1e-6 ? dPx / len : vec2(1.0, 0.0);
    vec2 offsetPx = vec2(-dPx.y, dPx.x) * (aLine.y * aLine.z * 0.5);
    vec4 clip = mix(clipA, clipB, aLine.x);
    clip.xy += (offsetPx * aScreen) * clip.w;
    gl_Position = clip;
}
