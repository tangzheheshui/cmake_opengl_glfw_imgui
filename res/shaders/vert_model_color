#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in mat4 aInstanceMatrix;

uniform mat4 uViewProj;
uniform vec4 uClipPlane;   // D7：xyz 法线，w 距离

out vec3 pFragPos;
out vec3 pNormal;
out float vClipDistance;

void main()
{
    pFragPos = (aInstanceMatrix * vec4(aPos, 1.0)).xyz;
    vClipDistance = dot(vec4(pFragPos, 1.0), uClipPlane);
    pNormal = mat3(transpose(inverse(aInstanceMatrix))) * aNormal;
    gl_Position = uViewProj * aInstanceMatrix * vec4(aPos, 1.0);
}
