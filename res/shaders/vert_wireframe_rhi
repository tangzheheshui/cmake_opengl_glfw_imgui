#version 330 core
// D5: 线框显示模式 顶点着色器（顶点布局与模型一致，复用 VB/IB/实例缓冲）
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;   // 未消费（布局对齐模型 VB）
layout (location = 2) in vec2 aTexCoord; // 未消费
layout (location = 3) in mat4 aInstanceMatrix;

uniform mat4 uViewProj;
uniform vec4 uClipPlane;   // D7：线框同样遵守剖切平面

out float vClipDistance;

void main()
{
    vec3 worldPos = (aInstanceMatrix * vec4(aPos, 1.0)).xyz;
    vClipDistance = dot(vec4(worldPos, 1.0), uClipPlane);
    gl_Position = uViewProj * aInstanceMatrix * vec4(aPos, 1.0);
}
