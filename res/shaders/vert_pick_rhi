#version 330 core
// RHI 拾取 顶点着色器（D2，GL 变体；与 res/shaders_vk/vert_pick_rhi.vert 语义一致）
// 只消费位置 + 实例矩阵；法线/UV 在管线顶点布局中存在但着色器不消费
layout (location = 0) in vec3 aPos;
layout (location = 3) in mat4 aInstanceMatrix;

uniform mat4 uViewProj;
uniform vec4 uPickColor;   // 对象 ID 编码色（CPU 侧编码，ID 渲染直出）

void main()
{
    gl_Position = uViewProj * aInstanceMatrix * vec4(aPos, 1.0);
}
