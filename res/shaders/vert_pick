#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in mat4 aInstanceMatrix;

uniform mat4 uViewProj;
uniform int uPickID;

out vec4 pColor;

void main()
{
    pColor.x = uPickID;
    gl_Position = uViewProj * aInstanceMatrix * vec4(aPos, 1.0);
}
