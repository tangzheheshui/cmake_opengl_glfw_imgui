#version 330 core
// V3-21：阴影接收面（GL 变体）：棋盘格 + 3x3 PCF
out vec4 FragColor;

in vec3 vWorld;

uniform sampler2D uShadowMap;
uniform mat4 uLightMat;   // 渲染侧已做 Reversed-Z 修正

void main()
{
    vec3 base = vec3(0.55);
    float checker = mod(floor(vWorld.x * 0.5) + floor(vWorld.z * 0.5), 2.0);
    base *= mix(0.75, 1.0, checker);

    float shadow = 1.0;
    vec4 ls = uLightMat * vec4(vWorld, 1.0);
    if (ls.w > 0.0) {
        vec3 proj = ls.xyz / ls.w;
        // GL 深度域 = NDC z 经 [0,1] 映射（0.5*z+0.5）；VK 直接是 z/w
        float pz = proj.z * 0.5 + 0.5;
        vec2 uv = vec2(proj.x * 0.5 + 0.5, proj.y * 0.5 + 0.5);
        if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0
            && pz > 0.0 && pz < 1.0) {
            vec2 texel = 1.0 / vec2(textureSize(uShadowMap, 0));
            float lit = 0.0;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    float d = texture(uShadowMap, uv + vec2(dx, dy) * texel).r;
                    lit += (pz >= d - 0.0015) ? 1.0 : 0.0;
                }
            }
            shadow = mix(0.35, 1.0, lit / 9.0);
        }
    }
    FragColor = vec4(base * shadow, 1.0);
}
