#version 330 core
// D1 收尾：边缘抗锯齿 + 圆头端点。
// vLine = (侧向像素距离, 切向像素距离, 半宽像素, 段长或 -段长)——
// 顶点侧线性插值，片元得到逐像素距离场：
//   边缘 1px smoothstep 渐变（AA）；圆头以端点为圆心判圆内（w>0 时启用）。
in vec4 vLine;
out vec4 FragColor;

uniform vec3 uColor;

void main()
{
    float halfW = vLine.z;
    float along = vLine.y;
    bool  round = vLine.w > 0.0;

    float r = abs(vLine.x);                                   // 默认：侧向距离
    if (round) {
        if (along < 0.0) {
            r = length(vec2(along, vLine.x));                 // A 端圆头
        } else if (along > vLine.w) {
            r = length(vec2(along - vLine.w, vLine.x));       // B 端圆头
        }
    }

    // 边缘 AA：r 在 [halfW-1, halfW] 内 1px 渐变（屏幕像素单位）
    float alpha = 1.0 - smoothstep(halfW - 1.0, halfW, r);
    if (alpha <= 0.003) discard;
    FragColor = vec4(uColor, alpha);
}
