#version 330 core

out vec4 FragColor;

in VS_OUT
{
    vec3 pFragPos;
    vec3 pNormal;
    vec2 pTexCoord;
    mat3 pMatNormal;
} fs_in;
in float vClipDistance;   // D7：剖切平面

struct Materail {
    vec3 ambient;      // 未用（PBR）
    vec3 diffuse;      // baseColor 乘数
    vec3 specular;     // 未用（PBR）
    float metallic;
    float roughness;
    float ao;
    int has_normal_tex;
};

struct Light {
    bool is_open;
    vec4 position;
    vec3 direction;
    float cosTheta;
    vec3 ambient;
    vec3 diffuse;   // 直接光 radiance
    vec3 specular;  // 未用（PBR）
};

uniform Materail uMaterail;
uniform Light uLight;
uniform vec3 uCameraPos;
uniform vec4 uHighlight;   // D8：选中高亮 rgb 颜色 + a 强度（0 = 关）
uniform vec4 uHover;       // 悬停高亮（更弱的提示色，不覆盖选中）
uniform float uOpacity;    // D3：不透明度（1 = 不透明；<1 走 blend 管线）
uniform sampler2D texture_diffuse0;
uniform sampler2D texture_metalrough0;   // PBR：metallic=B 通道，roughness=G 通道
uniform sampler2D texture_normal0;
uniform sampler2D texture_ao0;           // PBR：环境光遮蔽
// V3-21：阴影（贴图固定在纹理单元 4；uShadowEnabled=0 时不采样）
uniform sampler2D uShadowMap;
uniform mat4 uLightSpaceMatrix;   // 已做 Reversed-Z 修正
uniform int uShadowEnabled;
uniform bool uHasMetalrough;      // misc.z：有金属度-粗糙度贴图
uniform bool uHasAo;              // misc.w：有 AO 贴图

const float PI = 3.14159265359;

// Cook-Torrance 法线分布（GGX / Trowbridge-Reitz）
float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / (PI * denom * denom);
}

// 几何遮蔽（Schlick-GGX）
float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}
float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness)
         * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

// Fresnel（Schlick）
vec3 fresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

void main()
{
    if (vClipDistance < 0.0) discard;   // D7：剖切

    vec3 albedo = texture(texture_diffuse0, fs_in.pTexCoord).rgb * uMaterail.diffuse;
    float metallic  = uMaterail.metallic;
    float roughness = clamp(uMaterail.roughness, 0.04, 1.0);
    float ao        = uMaterail.ao;

    // PBR 贴图覆盖（有贴图时从贴图读，否则用标量兜底）
    if (uHasMetalrough) {
        vec3 mr = texture(texture_metalrough0, fs_in.pTexCoord).rgb;
        roughness = clamp(mr.g, 0.04, 1.0);
        metallic  = mr.b;
    }
    if (uHasAo) {
        ao = texture(texture_ao0, fs_in.pTexCoord).r;
    }

    vec3 N = normalize(fs_in.pNormal);
    if (uMaterail.has_normal_tex == 1) {
        N = texture(texture_normal0, fs_in.pTexCoord).xyz;
        N = normalize(N * 2.0 - 1.0);
        N = normalize(fs_in.pMatNormal * N);
    }

    vec3 V = normalize(uCameraPos - fs_in.pFragPos);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);   // 非金属 0.04，金属用 albedo

    vec3 result = vec3(0.0);

    if (uLight.is_open) {
        vec3 L = normalize(uLight.position.xyz - fs_in.pFragPos);
        float cos = dot(-L, normalize(uLight.direction));

        if (cos > uLight.cosTheta) {
            vec3 H = normalize(V + L);
            vec3 radiance = uLight.diffuse;

            float NDF = DistributionGGX(N, H, roughness);
            float G   = GeometrySmith(N, V, L, roughness);
            vec3  F   = fresnelSchlick(max(dot(H, V), 0.0), F0);

            vec3 numerator = NDF * G * F;
            float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) + 0.0001;
            vec3 specular = numerator / denominator;

            vec3 kS = F;
            vec3 kD = (1.0 - kS) * (1.0 - metallic);
            float NdotL = max(dot(N, L), 0.0);
            result += (kD * albedo / PI + specular) * radiance * NdotL;
        }
    }

    // ambient（IBL 未上，先用环境光近似 + AO）
    result += uLight.ambient * albedo * ao;

    // V3-21：阴影（3x3 PCF，Reversed-Z：越大越近）
    if (uShadowEnabled == 1 && uLight.is_open) {
        vec4 ls = uLightSpaceMatrix * vec4(fs_in.pFragPos, 1.0);
        if (ls.w > 0.0) {
            vec3 proj = ls.xyz / ls.w;
            float pz = proj.z * 0.5 + 0.5;
            vec2 uv = vec2(proj.x * 0.5 + 0.5, proj.y * 0.5 + 0.5);
            if (uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0
                && pz > 0.0 && pz < 1.0) {
                vec2 texel = 1.0 / vec2(textureSize(uShadowMap, 0));
                float lit = 0.0;
                for (int dy = -1; dy <= 1; ++dy) {
                    for (int dx = -1; dx <= 1; ++dx) {
                        float d = texture(uShadowMap, uv + vec2(dx, dy) * texel).r;
                        lit += (pz >= d - 0.0015) ? 1.0 : 0.0;
                    }
                }
                result *= mix(0.45, 1.0, lit / 9.0);
            }
        }
    }

    // D8：选中高亮混合（uHighlight.a = 0 时无效果）
    result = mix(result, uHighlight.rgb, uHighlight.a);
    result = mix(result, uHover.rgb, uHover.a);   // 悬停提示（选中优先级更高）

    FragColor = vec4(result, uOpacity);   // D3：材质不透明度
}
